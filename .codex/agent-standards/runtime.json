{
  "plugins": {
    "auditing@npomfret": ".codex/agent-standards/plugins/auditing",
    "browser-testing@npomfret": ".codex/agent-standards/plugins/browser-testing",
    "browser@npomfret": ".codex/agent-standards/plugins/browser",
    "frontend-design@claude-plugins-official": ".codex/agent-standards/plugins/frontend-design",
    "playwright@claude-plugins-official": ".codex/agent-standards/plugins/playwright",
    "scripting@npomfret": ".codex/agent-standards/plugins/scripting",
    "task-files@npomfret": ".codex/agent-standards/plugins/task-files",
    "typesafe@typesafe-ai": ".codex/agent-standards/plugins/typesafe",
    "web-factoring@npomfret": ".codex/agent-standards/plugins/web-factoring",
    "webstorm@npomfret": ".codex/agent-standards/plugins/webstorm"
  },
  "hooks": {
    "auditing@npomfret": {
      "PostToolUse": [
        {
          "matcher": "Read|Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\" --forget",
              "timeout": 10
            }
          ]
        }
      ]
    },
    "browser-testing@npomfret": {
      "PostToolUse": [
        {
          "matcher": "Read|Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\" --forget",
              "timeout": 10
            }
          ]
        }
      ]
    },
    "browser@npomfret": {
      "PreToolUse": [
        {
          "matcher": "mcp__plugin_playwright_playwright__.*",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
              "timeout": 10
            }
          ]
        }
      ]
    },
    "scripting@npomfret": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/lint_shell.py\" --hook",
              "timeout": 30
            }
          ]
        }
      ]
    },
    "web-factoring@npomfret": {
      "PostToolUse": [
        {
          "matcher": "Read|Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\" --forget",
              "timeout": 10
            }
          ]
        }
      ]
    },
    "webstorm@npomfret": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py\"",
              "timeout": 10
            }
          ]
        }
      ]
    },
    "project": {}
  },
  "rules": []
}
